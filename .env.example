APP_NAME="Energi.Click"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# IP proxy yang dipercaya membawa IP asli pengunjung (X-Forwarded-For).
# Wajib diisi bila situs di belakang reverse proxy / CDN (LiteSpeed proxy,
# Cloudflare) — tanpa ini rate limit per-IP dihitung dari IP proxy dan
# dibagi seluruh pengunjung (error 429 acak). Isi "*" atau daftar IP koma.
TRUSTED_PROXIES=

# Storefront brand/store name shown in the logo & page titles.
APP_BRAND="Energi.Click"

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
# Local/dev can use sqlite. For production use MySQL 8+ (recommended).
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=rekasurya_store
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set SESSION_SECURE_COOKIE=true in production behind HTTPS.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email. Dev: "log" writes mail to storage/logs. Production: use SMTP below.
# --- Hostinger business email (mailbox info@energi.click) ---
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.hostinger.com
#   MAIL_PORT=465
#   MAIL_USERNAME=info@energi.click
#   MAIL_PASSWORD=<password mailbox info@energi.click>
#   MAIL_SCHEME=smtps          # port 465 = SSL. (Alternatif: PORT=587 + MAIL_SCHEME=null untuk STARTTLS)
#   MAIL_FROM_ADDRESS=info@energi.click
#   MAIL_FROM_NAME="${APP_NAME}"
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=info@energi.click
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Rekasurya Store — business configuration
# Most of these are ALSO editable at runtime via Admin → Pengaturan (settings
# table). The values here are only fallbacks / bootstrap defaults.
# ---------------------------------------------------------------------------
COMPANY_LEGAL_NAME="PT Rekasurya Primadaya"
COMPANY_NPWP="01.234.567.8-901.000"
COMPANY_ADDRESS="Jl. Energi Surya No. 1, Jakarta Selatan"
COMPANY_EMAIL="sales@rekasurya.test"
COMPANY_PHONE="021-5000-1234"

# WhatsApp consultation button. International format, digits only.
WHATSAPP_ENABLED=true
WHATSAPP_NUMBER=628123456789

# WhatsApp NOTIFICATIONS via Wablas (https://wablas.com). Set the token in your
# server .env only — never commit it. base_url = the server your device is on.
WABLAS_ENABLED=false
WABLAS_BASE_URL=https://console.wablas.com
WABLAS_TOKEN=
# Shared secret for the incoming-message webhook. Set the webhook URL in the
# Wablas console to: https://YOUR-DOMAIN/webhook/wablas?token=THIS_VALUE
WABLAS_WEBHOOK_TOKEN=
# Sebagian server Wablas mengirim NAMA FILE saja untuk media masuk.
# Isi base URL penyimpanan medianya agar foto tampil di inbox, contoh:
# WABLAS_MEDIA_BASE_URL=https://pati.wablas.com/media/
WABLAS_MEDIA_BASE_URL=

# CS Assistant (Claude / Anthropic). Set the API key in your server .env only —
# never commit it. Get a key at https://console.anthropic.com. Model options:
# claude-sonnet-5 (default, balanced), claude-haiku-4-5 (cheaper/faster),
# claude-opus-4-8 (most capable). Leave disabled to run without an AI key.
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5

# Ongkir kurir reguler via RajaOngkir/Komerce (https://collaborator.komerce.id
# → API Key "Shipping Cost"). Isi key di .env server saja — jangan di-commit.
# ORIGIN_ID = ID kelurahan gudang, cari dengan: php artisan ongkir:cari "nama
# kelurahan". COURIERS dipisah ":" — pilihan: jne, jnt, sicepat, pos, tiki,
# anteraja, ninja, lion, ide, sap. Paket gratis ±100 request/hari; tarif
# di-cache 12 jam (CACHE_MINUTES).
RAJAONGKIR_ENABLED=false
RAJAONGKIR_API_KEY=
RAJAONGKIR_ORIGIN_ID=
RAJAONGKIR_COURIERS=jne:jnt
RAJAONGKIR_MAX_WEIGHT_GRAMS=50000
RAJAONGKIR_CACHE_MINUTES=720

# Tax (PPN)
PPN_PERCENT=11
PPN_ENABLED=true

# Show seeded demo credentials on the login screen (disable in production!)
DEMO_EXPOSE_CREDENTIALS=true

# ---------------------------------------------------------------------------
# Payment gateway secrets — NEVER commit real values. Set them only in .env.
# The reference "va_demo" gateway verifies webhooks with an HMAC-SHA256 secret.
# Real gateways (Midtrans/Xendit/etc.) add their own keys here and a matching
# adapter class under app/Services/Payment/.
# ---------------------------------------------------------------------------
DEMO_GATEWAY_SECRET=
